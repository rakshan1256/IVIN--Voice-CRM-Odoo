<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_ai_copilot" model="ir.ui.view">
        <field name="name">res.config.settings.view.ai.copilot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <app string="AI CRM Copilot"
                     name="voice_crm_fixed_v2"
                     groups="base.group_system">

                    <block title="AI Provider Settings">

                        <setting string="AI Provider">
                            <field name="ai_provider" widget="radio"/>
                        </setting>

                        <setting string="OpenAI API Key">
                            <field name="openai_api_key" password="True"/>
                        </setting>

                        <setting string="OpenAI Model">
                            <field name="openai_model"/>
                        </setting>

                        <setting string="Gemini API Key">
                            <field name="gemini_api_key" password="True"/>
                        </setting>

                        <setting string="Gemini Model">
                            <field name="gemini_model"/>
                        </setting>

                        <setting string="Ollama Base URL">
                            <field name="ollama_base_url"/>
                        </setting>

                        <setting string="Ollama Model">
                            <field name="ollama_model"/>
                        </setting>

                    </block>

                    <block title="🇮🇳 Sarvam AI — Indian Language Translation (Tamil &amp; Hindi)">

                        <setting string="Sarvam API Key"
                                 help="Get your key at https://dashboard.sarvam.ai — once added, Tamil and Hindi buttons appear inside the AI Copilot panel automatically.">
                            <field name="sarvam_api_key" password="True"/>
                        </setting>

                    </block>

                </app>

            </xpath>

        </field>
    </record>

</odoo>